# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object storage (MinIO local; qualquer S3-compatível)
# STORAGE_ENDPOINT: endereço interno (nome do serviço no compose)
# STORAGE_PUBLIC_ENDPOINT: endereço visto pelo navegador — aponte para a porta
# publicada da API do MinIO no host (MINIO_API_HOST_PORT)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube-secret
STORAGE_VIDEOS_BUCKET=videos
STORAGE_THUMBNAILS_BUCKET=thumbnails

# Fila (Redis + BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# Docker Compose — portas publicadas no host (opcionais; padrão entre parênteses)
# COMPOSE_PROJECT_NAME=streamtube
# API_HOST_PORT=3000
# DB_HOST_PORT=5432
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_UI_HOST_PORT=8025
# REDIS_HOST_PORT=6379
# MINIO_API_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
