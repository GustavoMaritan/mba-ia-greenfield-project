        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get one of my videos",
        "tags": [
          "videos"
        ]
      }
    },
    "/channels/me/videos/{id}/upload-parts": {
      "post": {
        "description": "Returns presigned URLs (valid for 1 hour) for the requested part numbers. The client PUTs each 64 MiB chunk straight to storage; no video bytes go through the API.",
        "operationId": "ChannelVideosController_signUploadParts",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUploadPartsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedUploadPartsResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed or part number above the video part count",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found in the caller channel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is not a draft accepting uploads",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Sign upload parts",
        "tags": [
          "videos"
        ]
      },
      "get": {
        "description": "Lists the parts already stored for the upload in progress, so an interrupted upload can resume from the missing parts.",
